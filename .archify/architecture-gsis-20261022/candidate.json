      "dot": "cyan",
      "title": "Five views",
      "items": [
        "Calendar sets school dates; Contacts supplies current authority.",
        "Deploy plans staffing; Layout shows the campus; Roster manages absence and relief."
      ]
    },
    {
      "dot": "emerald",
      "title": "Concurrent absence reports",
      "items": [
        "Slow reference lookups run before the write lock.",
        "Current attendance, overlap checks and relief consequences commit together.",
        "An exact retry recovers one durable result."
      ]
    },
    {
      "dot": "amber",
      "title": "Separate delivery work",
      "items": [
        "Roster and delivery methods share one Apps Script deployment but use independent stores and locks.",
        "Queue wake is optional; cron remains the fallback.",
        "Uncertain WhatsApp outcomes stay uncertain until reconciled."
      ]
    },
