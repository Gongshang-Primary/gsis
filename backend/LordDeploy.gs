 if(!entry.store){const rows=b.getSheetByName('deploy_documents').getRange(entry.row,1,entry.parts,4).getValues();if(rows.some((row,i)=>row[0]!==entry.id||row[1]!==entry.commit||Number(row[2])!==i))lordSourceError_(503,'SOURCE_INVALID','Published Deploy storage needs review.');return JSON.parse(rows.map(row=>row[3]).join(''));}
