  if(!/^[-\w]{1,100}$/.test(t.id||'')||ids.has(t.id)||typeof t.name!=='string'||!t.name.trim()||names.has(t.name.trim().toLowerCase()))error_(400,'Rules need unique names and IDs');
  ids.add(t.id);names.add(t.name.trim().toLowerCase());
  if(!sources.includes(t.source)||typeof t.match!=='string'||!t.match.trim()||t.match.length>120)error_(400,'Choose a rule source and matching value');
  const match=t.source+'|'+t.match.trim().toLowerCase();if(matches.has(match))error_(400,'Only one rule per source and matching value');matches.add(match);
  for(const field of ['percent','actingPercent'])if(t[field]!==''&&(!Number.isFinite(Number(t[field]))||Number(t[field])<0||Number(t[field])>100))error_(400,'Offload must be 0–100% or blank');
  if(t.periods!==''&&(!Number.isFinite(Number(t.periods))||Number(t.periods)<0||Number(t.periods)>200))error_(400,'Periods per week must be 0–200 or blank');
