 if(value.baseline!==null&&value.baseline!==undefined&&value.baseline!==''&&(!Number.isFinite(Number(value.baseline))||Number(value.baseline)<=0||Number(value.baseline)>200))error_(400,'Invalid teaching-period baseline');
