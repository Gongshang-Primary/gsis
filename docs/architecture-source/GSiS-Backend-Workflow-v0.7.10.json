    },
    {
      "id": "show",
      "lane": "ui",
      "col": 4,
      "type": "frontend",
      "label": "Render data",
      "sublabel": "Revision retained"
    },
    {
      "id": "save",
      "lane": "write",
      "col": 0,
      "type": "frontend",
      "label": "Save or publish",
      "sublabel": "Stable request ID"
    },
    {
      "id": "lock",
      "lane": "write",
      "col": 1,
      "type": "security",
      "label": "Acquire lock",
