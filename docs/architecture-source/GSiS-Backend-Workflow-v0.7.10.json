      "id": "async",
      "label": "Scheduled side effects"
    }
  ],
  "nodes": [
    {
      "id": "read",
      "lane": "ui",
      "col": 0,
      "type": "frontend",
      "label": "Open / filter",
      "sublabel": "Reuse loaded baseline"
    },
    {
      "id": "local",
      "lane": "ui",
      "col": 1,
      "type": "frontend",
      "label": "Local view",
      "sublabel": "Names and highlights"
    },
    {
      "id": "gateway",
      "lane": "read",
      "col": 1,
      "type": "security",
      "label": "Gateway",
      "sublabel": "Verify identity"
    },
    {
      "id": "authority",
      "lane": "read",
      "col": 2,
      "type": "backend",
      "label": "Current context",
      "sublabel": "Contacts + Calendar"
    },
    {
      "id": "fetch",
      "lane": "read",
      "col": 3,
      "type": "database",
      "label": "Scoped reads",
