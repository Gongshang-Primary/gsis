    {
      "id": "send",
      "lane": "async",
      "col": 3,
      "type": "external",
      "label": "Send / report",
      "sublabel": "Meta or MailApp"
    },
    {
      "id": "delivery",
      "lane": "async",
      "col": 4,
      "type": "backend",
      "label": "Record outcome",
      "sublabel": "Callback or uncertain"
