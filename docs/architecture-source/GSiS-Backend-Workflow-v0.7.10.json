  "cards": [
    {
      "dot": "cyan",
      "title": "Read",
      "items": [
        "Warm names, timetable filters and highlighting run locally. Fresh operational state still comes from the backend.",
        "Immutable model cache is not authority to assign a teacher."
      ]
    },
    {
      "dot": "emerald",
      "title": "Write",
      "items": [
        "Deploy field saves use durable journals and a final index marker. Roster operational changes use one locked JSON commit.",
        "Conflicts and uncertain results retain drafts. Retry the same request; do not assume a timeout means no write."
      ]
    },
    {
      "dot": "amber",
      "title": "Scheduled work",
      "items": [
        "Automatic allocation is a draft operation with its own saved switch. WhatsApp, the menu and diagnostics have separate platform gates.",
        "Publication remains deliberate and current Singapore schoolday only. Mail and Meta are separate side effects; no global transaction."
      ]
    },
    {
      "dot": "violet",
      "title": "Evidence",
      "items": [
        "Source: backend/FieldStore.gs, backend/RosterOperations.gs, shared/roster-operations.js and notification-worker/index.js.",
        "This diagram shows ordering and boundaries, not measured duration or a guarantee of provider delivery."
      ]
    }
  ]
}