function venuesRecipientEmails_(person){return Array.from(new Set([person.email,person.cesEmail].map(function(x){return String(x||'').trim().toLowerCase();}).filter(function(x){return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(x);})));}
function venuesManageUrl_(kind,id,settings){var origin=(settings?settings.VENUES_PUBLIC_URL:PropertiesService.getScriptProperties().getProperty('VENUES_PUBLIC_URL'))||'';if(!/^https:\/\/[a-z0-9-]+\.gsps\.edu\.sg\/?$/.test(origin))venuesSourceError_('NOTIFICATION_SETUP_REQUIRED','Configure the authenticated Venues public URL.');return origin.replace(/\/$/,'')+(String(kind).toLowerCase().indexOf('transfer')>=0||kind==='request'?'/r/':'/b/')+encodeURIComponent(id);}
function venuesMobile_(value){var number=String(value||'').replace(/[\s()+-]/g,'');if(/^[89]\d{7}$/.test(number))number='65'+number;return /^[1-9]\d{7,14}$/.test(number)?number:'';}
function venuesDeliveryStatus_(row){var statuses=(row.deliveries||[]).map(function(d){return d.status;});row.status=['uncertain','sending','failed','setup-required','queued'].find(function(s){return statuses.indexOf(s)>=0;})||(statuses.length?'sent':'setup-required');row.publicError=row.status==='sent'?'':row.status==='uncertain'?'Provider acceptance is uncertain. Review before retrying.':row.status==='setup-required'?'Notification settings or recipient contact data need attention.':row.status==='failed'?'A delivery attempt failed. It will retry after backoff.':'';}
function venuesExpandNotifications_(){
 return venuesTransaction_(function(state){var changed=false,now=venuesSourceNow_();(state.outbox||[]).forEach(function(row){if(row.status==='sent')return;if(!row.deliveries){row.deliveries=[];(row.participantIds||[]).forEach(function(id){var person=state.people.find(function(p){return p.id===id&&p.active;})||{},emails=venuesRecipientEmails_(person);(emails.length?emails:['']).forEach(function(email){row.deliveries.push({id:Utilities.getUuid(),participantId:id,channel:'email',contactField:email===String(person.cesEmail||'').trim().toLowerCase()&&email!==String(person.email||'').trim().toLowerCase()?'cesEmail':'email',recipient:email,status:'queued',attempts:0});});row.deliveries.push({id:Utilities.getUuid(),participantId:id,channel:'whatsapp',recipient:venuesMobile_(person.mobile),status:'queued',attempts:0});});row.revision++;changed=true;}
   (row.participantIds||[]).forEach(function(id){var person=state.people.find(function(p){return p.id===id&&p.active;});if(!person)return;var addresses=venuesRecipientEmails_(person),fields=addresses.map(function(address){return {field:address===String(person.email||'').trim().toLowerCase()?'email':'cesEmail',address:address};});if(!fields.length)fields=[{field:'email',address:''}];
    fields.forEach(function(target){var delivery=row.deliveries.find(function(d){return d.participantId===id&&d.channel==='email'&&d.contactField===target.field;});if(!delivery){row.deliveries.push({id:Utilities.getUuid(),participantId:id,channel:'email',contactField:target.field,recipient:target.address,status:'queued',attempts:0});changed=true;row.revision++;}else if(['queued','failed','setup-required','superseded'].includes(delivery.status)&&(delivery.recipient!==target.address||delivery.status==='superseded')){delivery.recipient=target.address;delivery.status='queued';delivery.nextAttemptAt='';delivery.error='';changed=true;row.revision++;}});
    row.deliveries.forEach(function(delivery){if(delivery.participantId===id&&delivery.channel==='email'&&['queued','failed','setup-required'].includes(delivery.status)&&!fields.some(function(target){return target.field===delivery.contactField;})){delivery.status='superseded';delivery.error='Contact address is no longer available; current address channels remain active.';changed=true;row.revision++;}});
   });
   row.deliveries.forEach(function(delivery){if(delivery.status==='sending'&&Date.parse(now)-Date.parse(delivery.attemptedAt)>600000){delivery.status='uncertain';delivery.error='Previous send did not record a verified outcome.';row.revision++;changed=true;}});venuesDeliveryStatus_(row);
  });return changed?{state:state,result:null}:{result:null};});
}
function venuesNotificationConfig_(){var p=PropertiesService.getScriptProperties(),config={};['PUBLIC_URL','EMAIL_ENABLED','WHATSAPP_ENABLED','WHATSAPP_ACCESS_TOKEN','WHATSAPP_BUSINESS_ACCOUNT_ID','WHATSAPP_PHONE_NUMBER_ID','WHATSAPP_API_VERSION','WHATSAPP_TEMPLATE'].forEach(function(key){config[key]=p.getProperty('VENUES_'+key)||'';});return config;}
function venuesApprovedTemplate_(config){
 if(config.WHATSAPP_ENABLED!=='true'||!config.WHATSAPP_ACCESS_TOKEN||!/^\d+$/.test(config.WHATSAPP_BUSINESS_ACCOUNT_ID)||!/^\d+$/.test(config.WHATSAPP_PHONE_NUMBER_ID)||!/^v\d+\.\d+$/.test(config.WHATSAPP_API_VERSION))return {status:'setup-required',error:'Configure approved WhatsApp delivery.'};
 var template;try{template=JSON.parse(config.WHATSAPP_TEMPLATE);}catch(_){return {status:'setup-required',error:'Configure the approved Venues template.'};}
 var fields=['recipient_name','event','venue','date','status','manage_url'];
 if(!template||!Array.isArray(template.fields)||JSON.stringify(template.fields)!==JSON.stringify(fields)||!/^\w+$/.test(template.name||'')||!/^\w+$/.test(template.language||'')||typeof template.body!=='string'||!/^.*venue/im.test(template.body)||JSON.stringify(template.body.match(/\{\{\d+\}\}/g))!==JSON.stringify(fields.map(function(_,i){return '{{'+(i+1)+'}}';})))return {status:'setup-required',error:'Template must use the six documented Venues body fields.'};
 try{var url='https://graph.facebook.com/'+config.WHATSAPP_API_VERSION+'/'+config.WHATSAPP_BUSINESS_ACCOUNT_ID+'/message_templates?name='+encodeURIComponent(template.name)+'&fields=name,language,status,components&limit=100',response=UrlFetchApp.fetch(url,{headers:{Authorization:'Bearer '+config.WHATSAPP_ACCESS_TOKEN},muteHttpExceptions:true,followRedirects:false});if(response.getResponseCode()!==200)return {status:'failed',error:'Template approval could not be checked.'};var found=JSON.parse(response.getContentText()).data;if(!Array.isArray(found))throw Error('Invalid template list');var approved=found.filter(function(t){return t.name===template.name&&t.language===template.language&&t.status==='APPROVED';});
  if(approved.length!==1||!Array.isArray(approved[0].components)||approved[0].components.filter(function(c){return c.type==='BODY'&&c.text===template.body;}).length!==1||approved[0].components.some(function(c){return !['BODY','FOOTER','HEADER'].includes(c.type)||(c.type!=='BODY'&&(/\{\{/.test(c.text||'')||c.format&&c.format!=='TEXT'));}))return {status:'setup-required',error:'The configured Venues template is not approved with matching content.'};
  return {status:'ready',template:template};
 }catch(_){return {status:'failed',error:'Template approval could not be checked.'};}
}
function venuesNotificationMessage_(state,row,person){var venue=state.venues.find(function(v){return v.id===row.venueId;})||{},payload=row.payload||{},event=String(row.kind||'Venue update').replace(/([a-z])([A-Z])/g,'$1 $2'),link=venuesManageUrl_(row.kind,row.recordId),values=[person.name||'Staff member',event,venue.unit||'Venue',String(payload.date||''),String(payload.status||''),link];return {values:values,subject:'GSiS Venues: '+event,body:'Hi '+values[0]+',\n\nVenue: '+values[2]+'\nUpdate: '+values[1]+'\nDate: '+values[3]+'\nStatus: '+values[4]+'\n\nManage this request: '+link+'\n\nSign in with your school account to view or act on this record.'};}
function venuesClaimNotification_(config,approval){
 return venuesTransaction_(function(state){var now=venuesSourceNow_(),rows=state.outbox||[],changed=false;
  for(var i=0;i<rows.length;i++){var row=rows[i];if(row.status==='sent')continue;for(var j=0;j<(row.deliveries||[]).length;j++){var d=row.deliveries[j];if(!['queued','failed','setup-required'].includes(d.status)||(d.nextAttemptAt&&Date.parse(d.nextAttemptAt)>Date.parse(now)))continue;var person=state.people.find(function(p){return p.id===d.participantId&&p.active;}),problem='';
    if(!person)problem='The recipient is no longer an active staff contact.';else if(d.channel==='email'){if(config.EMAIL_ENABLED!=='true')problem='Email delivery has not been enabled.';else{var addresses=venuesRecipientEmails_(person);if(!d.recipient||addresses.indexOf(d.recipient)<0)problem='The queued address is no longer an authorised contact address.';}}
    else{if(!approval||approval.status!=='ready')problem=approval&&approval.error||'WhatsApp delivery has not been enabled.';else if(!venuesMobile_(person.mobile))problem='A valid staff mobile number is required.';else d.recipient=venuesMobile_(person.mobile);}
    var message;try{if(!problem)message=venuesNotificationMessage_(state,row,person);}catch(_){problem='Configure the authenticated Venues public URL.';}
    if(problem){var nextStatus=d.channel==='whatsapp'&&approval&&approval.status==='failed'?'failed':'setup-required';if(d.status!==nextStatus||d.error!==problem){d.status=nextStatus;d.error=problem;if(nextStatus==='failed')d.nextAttemptAt=new Date(Date.parse(now)+300000).toISOString();row.revision++;changed=true;}venuesDeliveryStatus_(row);continue;}
    d.status='sending';d.attemptToken=Utilities.getUuid();d.attemptedAt=now;d.attempts=(d.attempts||0)+1;d.error='';row.revision++;venuesDeliveryStatus_(row);return {state:state,result:{rowId:row.id,deliveryId:d.id,token:d.attemptToken,channel:d.channel,recipient:d.recipient,message:message}};
   }}return changed?{state:state,result:null}:{result:null};});
}
function venuesSendNotification_(claim,config,approval){
 if(claim.channel==='email'){try{MailApp.sendEmail({to:claim.recipient,subject:claim.message.subject,body:claim.message.body,name:'GSiS Venues'});return {status:'sent',providerId:''};}catch(_){return {status:'uncertain',error:'Email acceptance could not be verified.'};}}
 try{var response=UrlFetchApp.fetch('https://graph.facebook.com/'+config.WHATSAPP_API_VERSION+'/'+config.WHATSAPP_PHONE_NUMBER_ID+'/messages',{method:'post',headers:{Authorization:'Bearer '+config.WHATSAPP_ACCESS_TOKEN},contentType:'application/json',payload:JSON.stringify({messaging_product:'whatsapp',to:claim.recipient,type:'template',template:{name:approval.template.name,language:{code:approval.template.language},components:[{type:'body',parameters:claim.message.values.map(function(text){return {type:'text',text:text};})}]}}),followRedirects:false,muteHttpExceptions:true}),status=response.getResponseCode(),value;try{value=JSON.parse(response.getContentText());}catch(_){}
  if(status>=200&&status<300&&value&&Array.isArray(value.messages)&&value.messages[0]&&typeof value.messages[0].id==='string')return {status:'sent',providerId:value.messages[0].id};
  if(status>=400&&status<500)return {status:'failed',error:'WhatsApp rejected this delivery attempt.'};return {status:'uncertain',error:'WhatsApp acceptance could not be verified.'};
 }catch(_){return {status:'uncertain',error:'WhatsApp acceptance could not be verified.'};}
}
function venuesCompleteNotification_(claim,outcome){return venuesTransaction_(function(state){var row=state.outbox.find(function(n){return n.id===claim.rowId;}),d=row&&row.deliveries.find(function(d){return d.id===claim.deliveryId;});if(!d||d.status!=='sending'||d.attemptToken!==claim.token)return {result:null};Object.assign(d,outcome);d.completedAt=venuesSourceNow_();if(outcome.status==='failed')d.nextAttemptAt=new Date(Date.parse(d.completedAt)+Math.min(86400000,Math.pow(2,Math.min(d.attempts,10))*60000)).toISOString();row.revision++;venuesDeliveryStatus_(row);return {state:state,result:null};});}
function venuesDispatchNotifications_(limit){
 var started=Date.now(),sent=0;venuesRefreshContacts_();venuesExpandNotifications_();var config=venuesNotificationConfig_(),approval=venuesApprovedTemplate_(config);limit=Math.max(1,Math.min(10,Number(limit)||10));
 for(var i=0;i<limit&&Date.now()-started<45000;i++){var claim=venuesClaimNotification_(config,approval);if(!claim)break;var outcome=venuesSendNotification_(claim,config,approval);venuesCompleteNotification_(claim,outcome);if(outcome.status==='sent')sent++;}return {sent:sent};
}
function venuesPruneJobs_(){return venuesTransaction_(function(state){var now=Date.parse(venuesSourceNow_()),changed=false;[['receipts',30],['nonces',2],['outbox',90]].forEach(function(item){var table=item[0],removed=0;state[table]=(state[table]||[]).filter(function(row){var stamp=Date.parse(row.createdAt||row.at||'');if(removed<100&&Number.isFinite(stamp)&&now-stamp>item[1]*86400000&&(table!=='outbox'||row.status==='sent')){removed++;changed=true;return false;}return true;});});return changed?{state:state,result:null}:{result:null};});}
function venuesRunJobs(){var result={sync:'ready',notifications:'pending'};try{venuesEnsureFreshSources_();}catch(_){result.sync='stale';}try{result.notifications=venuesDispatchNotifications_(10);}catch(_){result.notifications='failed';}try{venuesPruneJobs_();venuesPruneSnapshots_();}catch(_){}return result;}
