        "language": "en",
        "category": "UTILITY",
        "components": [
          {
            "type": "BODY",
            "text": "Device collection check\n\nHi {{1}}, your booking for {{2}} with {{3}} devices for {{4}} meant for {{5}} started over 30 minutes ago, but collection has not been logged.\n\nIf you no longer need the devices, cancel the booking so another teacher can use them. If they are already collected and in use, record that here; a missing-photo incident will be logged. You may also indicate that you will collect later within your booking time.",
            "example": {
              "body_text": [
                [
                  "Ms Tan",
                  "Cart A",
                  "28",
                  "5A",
                  "Science"
                ]
              ]
            }
          },
          {
            "type": "BUTTONS",
            "buttons": [
              {
                "type": "URL",
                "text": "Update booking",
                "url": "https://REPLACE_LORD_HOST/?{{1}}",
                "example": [
                  "https://REPLACE_LORD_HOST/?bookingId=DEMO&flow=collection-response"
                ]
              }
            ]
          }
        ]
      },
      "parameterExample": [
        "Ms Tan",
        "Cart A",
        "28",
        "5A",
        "Science"
      ]
    },
