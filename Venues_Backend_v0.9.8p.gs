function venuesNotificationConfig_(){var p=PropertiesService.getScriptProperties(),config={};['PUBLIC_URL','EMAIL_ENABLED','WHATSAPP_ENABLED','WHATSAPP_ACCESS_TOKEN','WHATSAPP_BUSINESS_ACCOUNT_ID','WHATSAPP_PHONE_NUMBER_ID','WHATSAPP_API_VERSION','WHATSAPP_TEMPLATE'].forEach(function(key){config[key]=p.getProperty('VENUES_'+key)||'';});return config;}
